{
  "name": "polygraph-dashboard",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/export-runs.mjs && vite",
    "build": "node scripts/export-runs.mjs && vite build",
    "runs": "node scripts/export-runs.mjs",
    "preview": "vite preview",
    "phone": "npm run build && vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "sample": "node scripts/make-sample.mjs",
    "shots": "npm run build && node scripts/shots.mjs",
    "shots:directions": "node scripts/shoot-directions.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
