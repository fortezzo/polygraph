# Polygraph settings: template
# ----------------------------
# This file is a template and is safe to commit. Your real settings go in a
# file called .env next to this one. Git ignores .env, so keys never get
# committed. Never put a real key in this file.

# API keys. Leave them blank until you have one.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Any service that speaks OpenAI's chat format (Groq, OpenRouter, LM Studio...):
# its address (usually ending in /v1) and its key, if it needs one.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# The model `polygraph ask` and `polygraph run` use. Blank means llama3.2, through Ollama.
POLYGRAPH_MODEL=

# Where Ollama runs. Blank means http://127.0.0.1:11434 (this PC).
OLLAMA_HOST=
